# Endurecimiento general del sitio

# No listar el contenido de carpetas que no tengan index
Options -Indexes

# Ocultar la versión/firma del servidor en páginas de error
ServerSignature Off

# Bloquear el acceso directo a archivos sensibles en cualquier carpeta
<FilesMatch "\.(sql|log|env|ini|bak|sh|zip|tar|gz|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Bloquear cualquier archivo oculto (.env, .htpasswd, etc.)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Bloquear el directorio .git completo. El bloqueo de "archivos ocultos" de arriba
# NO alcanza a esto: <FilesMatch> solo evalúa el nombre del archivo, y los archivos
# dentro de .git/ (HEAD, config, pack-*.pack, etc.) no empiezan con punto, así que
# sin esta regla cualquiera podría reconstruir el repositorio completo pidiéndolos
# uno por uno (ataque tipo "git dumper").
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule "(^|/)\.git" - [F,L]
</IfModule>

# Forzar HTTPS en producción (deja esto comentado mientras pruebas en localhost/XAMPP;
# descoméntalo cuando el sitio ya tenga SSL activo en el hosting).
# RewriteCond %{HTTPS} off
# RewriteCond %{HTTP_HOST} !^localhost
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

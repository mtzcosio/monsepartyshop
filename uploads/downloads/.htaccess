# Las plantillas pagadas solo deben entregarse a través de descargar.php
# (que valida el token de compra, la expiración y el límite de descargas).
# Bloquear el acceso directo evita que alguien descargue el archivo
# adivinando o compartiendo su nombre, sin pasar por esa validación.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

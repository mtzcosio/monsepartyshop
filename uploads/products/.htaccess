# Esta carpeta sí debe ser accesible desde el navegador (son las imágenes
# de los productos), pero nunca debe poder ejecutarse un script subido
# aquí como si fuera PHP (protección extra además del filtro de
# extensiones en admin/product_form.php).
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>

<FilesMatch "\.(php|phtml|php\d*|pht|phar)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
